+static u16 nct6687_read(struct nct6687_data *data, u16 address)
+{
+	u16 res;
+
+	/* r257 dropped EC_io_lock. VRM shares this window outside update_lock. */
+	mutex_lock(&data->EC_io_lock);
+	res = nct6687_read_nolock(data, address);
+	mutex_unlock(&data->EC_io_lock);
 
 	return res;
 }
 
+/* Two indexes, one lock. A VRM PAGE sample cannot land between the bytes. */
+static void nct6687_read_pair(struct nct6687_data *data, u16 reg, u16 *first, u16 *second)
+{
+	mutex_lock(&data->EC_io_lock);
+	*first = nct6687_read_nolock(data, reg);
+	*second = nct6687_read_nolock(data, reg + 1);
+	mutex_unlock(&data->EC_io_lock);
+}
