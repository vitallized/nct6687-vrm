{
  "comment": "Integer millisi (mV, mA, mW/m°C). Kernel C (dkms/nct6687_vrm_decode.h) and Python (nct6687_vrm_decode.py) must return these exact values. Host binary: tests/vrm_decode.c.",
  "cases": [
    {
      "name": "vout_direct_mode2_0x40",
      "fn": "decode_vout_mv",
      "args": [1263, 64, -10],
      "expect": 1263,
      "note": "VOUT_MODE 0x40 Direct: raw 0x04ef → 1263 mV"
    },
    {
      "name": "vin_direct_10mV",
      "fn": "decode_vin_mv",
      "args": [1214],
      "expect": 12140,
      "note": "VIN Direct 10 mV/LSB: raw 0x04be → 12140 mV"
    },
    {
      "name": "linear11_temp_41c",
      "fn": "linear11_milli",
      "args": [41],
      "expect": 41000,
      "note": "LINEAR11 TEMP 0x0029 → 41000 m°C (41 °C)"
    },
    {
      "name": "linear11_neg_exp_neg_mant",
      "fn": "linear11_milli",
      "args": [63483],
      "expect": -1250,
      "note": "LINEAR11 0xf7fb: N=-2, Y=-5 → -1250 millisi"
    },
    {
      "name": "linear11_neg_truncation",
      "fn": "linear11_milli",
      "args": [59391],
      "expect": -62,
      "note": "LINEAR11 0xe7ff: N=-4, Y=-1 → integer 1000>>4 = 62, signed -62 (not float -62.5)"
    },
    {
      "name": "vout_linear16_n_from_mode",
      "fn": "decode_vout_mv",
      "args": [1263, 22, -10],
      "expect": 1233,
      "note": "VOUT LINEAR16 mode 0, VOUT_MODE 0x16 → N=-10; raw 0x04ef → (1263*1000)>>10 = 1233 mV"
    },
    {
      "name": "iout_direct_0x00e5",
      "fn": "decode_iout_ma",
      "args": [229],
      "expect": 22900,
      "note": "READ_IOUT Direct 0.1 A/LSB: 0x00E5 → 229*100 = 22900 mA"
    },
    {
      "name": "iin_direct_0x0231",
      "fn": "decode_iin_ma",
      "args": [561],
      "expect": 5610,
      "note": "READ_IIN Direct 0.01 A/LSB: 0x0231 → 561*10 = 5610 mA"
    },
    {
      "name": "pin_direct_0x0065",
      "fn": "decode_pin_uw",
      "args": [101],
      "expect": 101000000,
      "note": "READ_PIN Direct 1 W/LSB: 0x0065 → 101*1000000 = 101000000 uW"
    },
    {
      "name": "efficiency_36w_over_61w",
      "fn": "efficiency_pcm",
      "args": [36000000, 61000000],
      "expect": 59016,
      "note": "36/61*100 = 59.016% → 59016 milli-percent. HWiNFO divides the two stored powers."
    },
    {
      "name": "efficiency_clamps_at_100_percent",
      "fn": "efficiency_pcm",
      "args": [33000000, 29000000],
      "expect": 100000,
      "note": "33/29 is about 114%. HWiNFO minsd with 100.0, so this is 100%."
    },
    {
      "name": "efficiency_hides_non_positive",
      "fn": "efficiency_pcm",
      "args": [-1000000, 101000000],
      "expect": 0,
      "note": "POUT or PIN <= 0: HWiNFO omits VRM Efficiency."
    },
    {
      "name": "efficiency_pwm_59_percent",
      "fn": "efficiency_pwm",
      "args": [36000000, 61000000],
      "expect": 118,
      "note": "59% → pwm 118. sensors 3.6.2 prints count/2, so 118 is 59%."
    },
    {
      "name": "efficiency_pwm_100_percent",
      "fn": "efficiency_pwm",
      "args": [33000000, 29000000],
      "expect": 200,
      "note": "Capped 100% is pwm 200. 255 would print as 128% because the scale is 2, not 2.55."
    },
    {
      "name": "clamp_exp_high",
      "fn": "clamp_exp",
      "args": [20],
      "expect": 15,
      "note": "exponents above 15 clamp to 15"
    },
    {
      "name": "clamp_exp_low",
      "fn": "clamp_exp",
      "args": [-20],
      "expect": -16,
      "note": "exponents below -16 clamp to -16"
    },
    {
      "name": "clamp_exp_edges",
      "fn": "clamp_exp",
      "args": [15],
      "expect": 15,
      "note": "in-range exponent 15 unchanged"
    },
    {
      "name": "vout_fallback_exp_clamped_high",
      "fn": "decode_vout_mv",
      "args": [8, 32, 20],
      "expect": 262144000,
      "note": "VID mode 0x20 uses fallback_exp; 20 clamps to 15; (8*1000)<<15"
    },
    {
      "name": "vout_fallback_exp_clamped_low",
      "fn": "decode_vout_mv",
      "args": [65535, 32, -20],
      "expect": 999,
      "note": "fallback_exp -20 clamps to -16; (65535*1000)>>16 = 999"
    },
    {
      "name": "linear11_n_neg16_shift_clamped",
      "fn": "linear11_milli",
      "args": [32769],
      "expect": 0,
      "note": "LINEAR11 0x8001 N=-16, Y=1: right-shift uses clamp(16)=15, so 1000>>15 = 0"
    },
    {
      "name": "iout_from_pv_sample_fixture",
      "fn": "iout_from_pv_ma",
      "args": [50000, 1234],
      "expect": 40518,
      "note": "50 W / 1.234 V as millisi: (50000*1000)/1234 = 40518 mA, not float 50/1.234"
    },
    {
      "name": "iout_from_pv_exact",
      "fn": "iout_from_pv_ma",
      "args": [50000, 1000],
      "expect": 50000,
      "note": "exact 50 W / 1.000 V → 50000 mA"
    },
    {
      "name": "iout_from_pv_truncation",
      "fn": "iout_from_pv_ma",
      "args": [1000, 3],
      "expect": 333333,
      "note": "(1000*1000)/3 toward zero = 333333"
    },
    {
      "name": "iout_from_pv_just_above_200",
      "fn": "iout_from_pv_ma",
      "args": [10000, 201],
      "expect": 49751,
      "note": "helper has no 200 mV policy; 10000 mW / 201 mV"
    },
    {
      "name": "iout_from_pv_neg_pout",
      "fn": "iout_from_pv_ma",
      "args": [-1000, 3],
      "expect": -333333,
      "note": "toward-zero on negative POUT, not Python floor-div"
    }
  ]
}
