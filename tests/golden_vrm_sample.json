{
  "about": "PAGE sample PMBus traces. Kernel nct_vrm_sample_page (host C via tests/vrm_mailbox.c, real mailbox ops over a fake eSIO window) and Python _sample_page (FakeXfer) must both match. device: what the PMBus slave answers. Reading cmd 0x00 returns the last PAGE written unless page_readback overrides it. fail: nonzero status for one op kind and cmd. cache: PAGE + VOUT_MODE cache before/after (null = not cached). Raw words are hex strings; millisi are ints.",
  "scenarios": [
    {
      "name": "cold_cache_page0_writes_page_and_reads_vout_mode",
      "page": 0,
      "vout_exp": -10,
      "cache": {"page": -1, "vout_mode": [null, null]},
      "device": {
        "bytes": {"0x20": "0x40"},
        "words": {"0x8b": "0x04d2", "0x96": "0x0032", "0x88": "0x04b0", "0x8d": "0x0028"}
      },
      "expect": {
        "ops": [
          "write_byte 0x00 0x00",
          "read_byte 0x00",
          "read_byte 0x20",
          "read_word 0x8b",
          "read_word 0x96",
          "read_word 0x88",
          "read_word 0x8d"
        ],
        "error": false,
        "millisi": {"vout_mv": 1234, "vin_mv": 12000, "iout_ma": 40518, "pout_uw": 50000000, "temp_mc": 40000},
        "cache": {"page": 0, "vout_mode": ["0x40", null]}
      }
    },
