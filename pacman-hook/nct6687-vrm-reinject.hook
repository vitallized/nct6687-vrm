# Re-apply eSIO PMBus VRM splice after nct6687d-dkms-git is replaced by pacman.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = nct6687d-dkms-git

[Action]
Description = Re-apply NCT6687 VRM splice and rebuild DKMS
When = PostTransaction
Exec = /usr/bin/python3 /usr/local/lib/nct6687-vrm/nct6687_vrm_persist.py post_transaction
Depends = python
