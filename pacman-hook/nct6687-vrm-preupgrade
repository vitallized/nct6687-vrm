#!/bin/bash
# Pacman PreTransaction helper — drop unowned files in the DKMS src dir
# so a newly packaged file (e.g. Kbuild) cannot conflict.
set -euo pipefail

LIB=/usr/local/lib/nct6687-vrm
INJECT="$LIB/nct6687_vrm_dkms_inject.py"
LOG_TAG=nct6687-vrm-preupgrade

if [[ -f "$LIB/refresh-from-source.sh" ]]; then
	# shellcheck disable=SC1091
	. "$LIB/refresh-from-source.sh"
	nct6687_vrm_refresh_from_source || true
fi

if [[ ! -f "$INJECT" ]]; then
	echo "$LOG_TAG: missing $INJECT — re-run pacman-hook/install.sh from this repo" >&2
	exit 0
fi

exec /usr/bin/python3 "$INJECT" --pre-upgrade
